{
  "id": "@weaver/plugin-repository",
  "name": "Repository Integration",
  "version": "1.0.1",
  "description": "Link repositories and branches to projects and issues",
  "author": "Weaver",
  "icon": "git-branch",
  "type": "integration",
  "entrypoints": {
    "server": "src/server/index.ts"
  },
  "permissions": [
    "repository.read",
    "repository.manage"
  ],
  "declaredPermissions": [
    {
      "key": "repository.read",
      "label": "View repositories",
      "description": "View repository links on projects and issues"
    },
    {
      "key": "repository.manage",
      "label": "Manage repositories",
      "description": "Add, update, and remove repository links"
    }
  ],
  "settings": {
    "schema": {
      "defaultProvider": {
        "type": "select",
        "description": "Default Git provider",
        "options": [
          "github",
          "gitlab",
          "bitbucket"
        ],
        "default": "github"
      }
    }
  },
  "events": {
    "subscribes": [
      "issue.created",
      "project.created"
    ]
  },
  "routes": [
    {
      "method": "GET",
      "path": "/projects/:projectKey/repositories",
      "handler": "listRepositories",
      "requiredPermissions": [
        "repository.read"
      ]
    },
    {
      "method": "POST",
      "path": "/projects/:projectKey/repositories",
      "handler": "addRepository",
      "requiredPermissions": [
        "repository.manage"
      ]
    },
    {
      "method": "DELETE",
      "path": "/projects/:projectKey/repositories/:repoId",
      "handler": "removeRepository",
      "requiredPermissions": [
        "repository.manage"
      ]
    },
    {
      "method": "GET",
      "path": "/issues/:issueKey/repository-links",
      "handler": "listIssueLinks",
      "requiredPermissions": [
        "repository.read"
      ]
    }
  ],
  "migrations": [
    "migrations/001_create_repository_tables.sql"
  ]
}
