{
  "id": "@weaver/plugin-github",
  "name": "GitHub Integration",
  "version": "1.0.0",
  "description": "Link GitHub commits, pull requests, and branches to Weaver issues",
  "author": "Weaver Team",
  "icon": "github",
  "entrypoints": {
    "server": "./src/server/index.ts",
    "client": "./src/client/index.ts"
  },
  "permissions": ["issues:read", "issues:write", "webhooks:manage"],
  "settings": {
    "schema": {
      "webhookSecret": { "type": "string", "required": true, "description": "GitHub webhook secret for HMAC verification" },
      "appId": { "type": "string", "required": false, "description": "GitHub App ID (optional, for API access)" },
      "privateKey": { "type": "string", "required": false, "description": "GitHub App private key (optional)" }
    }
  },
  "events": {
    "subscribes": ["issue.created", "issue.status_changed"],
    "emits": ["github.push_received", "github.pr_opened", "github.pr_merged"]
  },
  "ui": {
    "slots": [
      { "slot": "issue-detail-panel", "component": "GitHubPanel" }
    ]
  },
  "routes": [
    { "method": "POST", "path": "/webhook", "handler": "handleWebhook" },
    { "method": "GET", "path": "/links/:issueKey", "handler": "getLinks" }
  ],
  "migrations": ["./migrations/001_create_github_links.sql"]
}
