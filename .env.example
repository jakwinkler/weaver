# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=weaver
DATABASE_PASSWORD=weaver_dev
DATABASE_NAME=weaver

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380

# Auth
JWT_SECRET=change-me-in-production-to-a-long-random-string
JWT_REFRESH_SECRET=use-a-different-long-random-string-for-refresh-tokens
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# App
API_PORT=3000
CORS_ORIGINS=http://localhost:5173
API_PREFIX=api/v1
NODE_ENV=development
WEAVER_TRUSTED_PLUGINS=

# Storage (local or s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
ATTACHMENT_MAX_BYTES=10485760

# S3 (when STORAGE_DRIVER=s3)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# Email (optional)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@weaver.dev
