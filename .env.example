# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=weaver
DATABASE_PASSWORD=weaver_dev
DATABASE_NAME=weaver

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
# NOTIFICATIONS_QUEUE_NAME=notifications

# Audit log retention
AUDIT_LOG_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_CRON="0 3 * * *"

# Auth
JWT_SECRET=change-me-in-production-to-a-long-random-string
JWT_REFRESH_SECRET=use-a-different-long-random-string-for-refresh-tokens

# Public URLs used in OAuth, SAML, and OIDC callbacks
API_PUBLIC_URL=http://localhost:3000
WEB_URL=http://localhost:5173

# Social OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Override the generated callback URLs only when your proxy requires it:
# GOOGLE_CALLBACK_URL=
# GITHUB_CALLBACK_URL=
# SAML_ISSUER=weaver

# App
API_PORT=3000
CORS_ORIGINS=http://localhost:5173
API_PREFIX=api/v1
WEB_APP_URL=http://localhost:5173
NODE_ENV=development
WEAVER_TRUSTED_PLUGINS=

# Storage (local or s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
ATTACHMENT_MAX_BYTES=10485760

# S3 (when STORAGE_DRIVER=s3)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# Email (optional)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_NAME=Weaver
# SMTP_FROM=noreply@weaver.dev
# EMAIL_UNSUBSCRIBE_SECRET=set-a-separate-long-random-secret-in-production

# Trust only the reverse proxy network when directly serving HTTP behind a proxy.
# TRUST_PROXY=loopback,uniquelocal
# Optional third-party avatar lookup; disabled by default.
# VITE_GRAVATAR_ENABLED=true

# Required on API and worker to enqueue/decrypt Jira imports (32 random bytes, base64).
# IMPORT_CREDENTIAL_KEY=
# Production registration stays disabled until schema bootstrap has been reviewed.
# ALLOW_TENANT_SCHEMA_BOOTSTRAP=false
