FROM node:20-alpine AS base
RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /app

# Install dependencies
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/config/package.json ./packages/config/
COPY packages/shared/package.json ./packages/shared/
COPY packages/db/package.json ./packages/db/
COPY packages/sdk/package.json ./packages/sdk/
COPY apps/api/package.json ./apps/api/
COPY plugins ./plugins
RUN pnpm install --frozen-lockfile

# Build
FROM base AS build
COPY --from=deps /app ./
COPY . .
RUN pnpm --filter @weaver/shared build && \
    pnpm --filter @weaver/sdk build && \
    pnpm --filter @weaver/db build && \
    pnpm --filter './plugins/*' build && \
    pnpm --filter @weaver/api build

# Production
FROM base AS production
ENV NODE_ENV=production
RUN mkdir -p /tmp/weaver-uploads && chown node:node /tmp/weaver-uploads
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY --from=build /app/packages/shared/package.json ./packages/shared/
COPY --from=build /app/packages/db/dist ./packages/db/dist
COPY --from=build /app/packages/db/package.json ./packages/db/
COPY --from=build /app/packages/sdk/dist ./packages/sdk/dist
COPY --from=build /app/packages/sdk/package.json ./packages/sdk/
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/apps/api/package.json ./apps/api/
COPY --from=build /app/plugins ./plugins

EXPOSE 3000
USER node
CMD ["node", "apps/api/dist/main.js"]
