# Copy outside the checkout and supply through --env-file.
# Existing installations must retain their Compose project name and image pins.
COMPOSE_PROJECT_NAME=weaver
WEAVER_PUBLIC_URL=https://weaver.example.com
WEB_PORT=3400
WEAVER_API_IMAGE=weaver-api:local
WEAVER_WORKER_IMAGE=weaver-worker:local
WEAVER_WEB_IMAGE=weaver-web:local

# Required: generate separate random values. Empty values fail Compose validation.
DATABASE_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=

# Optional social sign-in; both values are required for each enabled provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
WEAVER_TRUSTED_PLUGINS=

# Optional Jira imports: same base64-encoded 32-byte key on API and worker.
IMPORT_CREDENTIAL_KEY=
# New production schemas require explicit operator opt-in.
ALLOW_TENANT_SCHEMA_BOOTSTRAP=false
# Match the actual reverse-proxy network.
TRUST_PROXY=uniquelocal
