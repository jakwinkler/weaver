<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <style>
      body {
        margin: 0;
        background: #f3f4f6;
        color: #111827;
        font-family: Arial, sans-serif;
      }
      .shell {
        padding: 32px 16px;
      }
      .card {
        width: 100%;
        max-width: 560px;
        margin: 0 auto;
        background: #ffffff;
        border: 1px solid #e5e7eb;
      }
      .content {
        padding: 32px;
      }
      .eyebrow {
        color: #6b7280;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }
      h1 {
        margin: 8px 0 16px;
        font-size: 24px;
        line-height: 1.3;
      }
      p {
        margin: 0 0 16px;
        color: #374151;
        font-size: 15px;
        line-height: 1.6;
      }
      .button {
        display: inline-block;
        padding: 12px 18px;
        background: #2563eb;
        color: #ffffff !important;
        font-weight: 700;
        text-decoration: none;
      }
      .footer {
        padding: 20px 32px;
        border-top: 1px solid #e5e7eb;
        color: #6b7280;
        font-size: 12px;
        line-height: 1.5;
      }
      .footer a {
        color: #4b5563;
      }
      @media only screen and (max-width: 600px) {
        .shell {
          padding: 0;
        }
        .content,
        .footer {
          padding: 24px 20px;
        }
        h1 {
          font-size: 21px;
        }
      }
    </style>
  </head>
  <body>
    <div class='shell'>
      <div class='card'>
        <div class='content'>
          <div class='eyebrow'>Weaver account</div>
          <h1>Reset your password</h1>
          <p>Hi {{recipientName}},</p>
          <p>Someone asked to reset the password for your Weaver account. Use the button below to choose a new one.</p>
          <p>The link works once and expires in {{expiresInMinutes}} minutes. Asking for another link cancels this one.</p>
          <a class='button' href='{{resetUrl}}' rel='noreferrer'>Choose a new password</a>
        </div>
        <div class='footer'>If you didn't ask for this, you can ignore this email. Your password stays the same.</div>
      </div>
    </div>
  </body>
</html>
